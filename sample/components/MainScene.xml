<?xml version="1.0" encoding="utf-8" ?>

<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" onChange="onLaunchArgs" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/RemoteLogger.brs" />
    <script type="text/brightscript" uri="pkg:/source/flows/AppLog.brs" />
    <script type="text/brightscript" uri="pkg:/source/flows/HostLogger.brs" />
    <script type="text/brightscript" uri="pkg:/source/flows/RemoteLogHandler.brs" />
    <script type="text/brightscript" uri="pkg:/source/flows/FixedOutputLogger.brs" />
    <script type="text/brightscript" uri="pkg:/source/flows/RemoteLogOutput.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <Group id="MainView">
            <Label id="status" translation="[96, 96]" width="1728" wrap="true" text="Waiting for launch arguments" />
        </Group>
        <Timer id="ticker" duration="5" repeat="true" />
    </children>
</component>
