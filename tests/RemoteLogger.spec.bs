namespace tests
    @suite("RemoteLogger facade")
    class RemoteLoggerTests extends rooibos.BaseTestSuite
        @describe("level names")
        @it("maps each name to its value, ignoring case")
        sub mapsLevelNames()
            m.assertEqual(RemoteLogger_levelValue("error"), 1)
            m.assertEqual(RemoteLogger_levelValue("warn"), 2)
            m.assertEqual(RemoteLogger_levelValue("info"), 3)
            m.assertEqual(RemoteLogger_levelValue("DEBUG"), 4)
            m.assertEqual(RemoteLogger_levelValue("Trace"), 5)
        end sub

        @it("treats unknown and non-string names as info")
        sub unknownLevelIsInfo()
            m.assertEqual(RemoteLogger_levelValue("verbose"), 3)
            m.assertEqual(RemoteLogger_levelValue(""), 3)
            m.assertEqual(RemoteLogger_levelValue(invalid), 3)
            m.assertEqual(RemoteLogger_levelValue(2), 3)
        end sub

        @describe("disabled facade")
        @it("does nothing without a node on m.global")
        sub disabledWithoutNode()
            m.global.removeField("remoteLogger")
            logger = RemoteLogger("Test")
            m.assertInvalid(logger.node)
            logger.error("boom", { a: 1 })
            logger.write("info", "Test", "msg", invalid)
        end sub

        @describe("enabled facade")
        @beforeEach
        sub addSink()
            m.sink = CreateObject("roSGNode", "Node")
            m.sink.addField("level", "string", false)
            m.sink.addField("entry", "assocarray", true)
            m.sink.addField("ready", "boolean", false)
            m.sink.level = "info"
            m.sink.ready = true
            m.global.addFields({ remoteLogger: m.sink })
        end sub

        @afterEach
        sub removeSink()
            m.global.removeField("remoteLogger")
            m.sink = invalid
        end sub

        @it("skips entries below the level")
        sub filtersBelowLevel()
            logger = RemoteLogger("Test")
            logger.debug("hidden")
            logger.trace("hidden")
            ' An unset assocarray field is not an AA on device, so prove "not written" through seq.
            logger.info("shown")
            m.assertEqual(m.sink.entry.seq, 1)
            m.assertEqual(m.sink.entry.msg, "shown")
        end sub

        @it("writes entries at or above the level")
        sub writesAtOrAboveLevel()
            logger = RemoteLogger("Test")
            logger.info("shown")
            m.assertEqual(m.sink.entry.lvl, "info")
            logger.error("shown")
            m.assertEqual(m.sink.entry.lvl, "error")
        end sub

        @it("builds the entry with canonical fields")
        sub buildsEntry()
            logger = RemoteLogger("Player")
            logger.write("WARN", "Other", "state changed", { state: "playing" })
            entry = m.sink.entry
            m.assertAAHasKeys(entry, ["seq", "t", "lvl", "tag", "msg", "data"])
            m.assertEqual(entry.seq, 1)
            m.assertTrue(entry.t > 1700000000000&)
            m.assertEqual(entry.lvl, "warn")
            m.assertEqual(entry.tag, "Other")
            m.assertEqual(entry.msg, "state changed")
            m.assertEqual(entry.data, { state: "playing" })
        end sub

        @it("sends an unknown level as info")
        sub unknownLevelSentAsInfo()
            logger = RemoteLogger("Test")
            logger.write("verbose", "Test", "msg", invalid)
            m.assertEqual(m.sink.entry.lvl, "info")
        end sub

        @it("passes data through whatever its type")
        sub passesDataThrough()
            logger = RemoteLogger("Test")
            logger.info("array", [1, "two"])
            m.assertEqual(m.sink.entry.data, [1, "two"])
            logger.info("string", "text")
            m.assertEqual(m.sink.entry.data, "text")
            logger.info("none")
            m.assertInvalid(m.sink.entry.data)
        end sub

        @it("converts a non-string message")
        sub convertsMessage()
            logger = RemoteLogger("Test")
            logger.info(42)
            m.assertEqual(m.sink.entry.msg, "42")
            logger.info(invalid)
            m.assertEqual(m.sink.entry.msg, "invalid")
            logger.info({ a: 1 })
            m.assertTrue(RemoteLogger_isStringNotEmpty(m.sink.entry.msg))
        end sub

        @it("increments seq per entry")
        sub incrementsSeq()
            logger = RemoteLogger("Test")
            logger.info("one")
            m.assertEqual(m.sink.entry.seq, 1)
            logger.debug("filtered")
            logger.warn("two")
            m.assertEqual(m.sink.entry.seq, 2)
        end sub

        @it("reads the level once, at construction")
        sub cachesLevel()
            m.sink.level = "debug"
            logger = RemoteLogger("Test")
            m.sink.level = "error"
            logger.debug("still shown")
            m.assertEqual(m.sink.entry.lvl, "debug")
        end sub

        ' The sink keeps only the last written entry, so the order of the flush is checked
        ' on logger.buffer just before it, and the write on the sink's last entry.
        @describe("facade before the Task is ready")
        @beforeEach
        sub addSinkNotReady()
            m.addSink()
            m.sink.ready = false
            ' A sentinel, because an unset assocarray field is not an AA on device.
            m.sink.entry = { seq: 0, msg: "sentinel" }
        end sub

        @afterEach
        sub removeSinkNotReady()
            m.removeSink()
        end sub

        @it("buffers entries while the Task is not ready")
        sub buffersUntilReady()
            logger = RemoteLogger("Test")
            m.assertFalse(logger.ready)
            logger.info("one")
            logger.debug("filtered")
            logger.warn("two")
            m.assertEqual(m.sink.entry.msg, "sentinel")
            m.assertEqual(logger.buffer.count(), 2)
            m.assertEqual(logger.buffer[0].seq, 1)
            m.assertEqual(logger.buffer[0].msg, "one")
            m.assertEqual(logger.buffer[1].seq, 2)
            m.assertEqual(logger.buffer[1].msg, "two")
        end sub

        @it("writes the buffered entries, then the new one, once the Task is ready")
        sub flushesWhenReady()
            logger = RemoteLogger("Test")
            logger.info("one")
            logger.info("two")
            m.sink.ready = true
            logger.info("three")
            m.assertTrue(logger.ready)
            m.assertFalse(logger.doesExist("buffer"))
            m.assertEqual(m.sink.entry.seq, 3)
            m.assertEqual(m.sink.entry.msg, "three")
        end sub

        @it("stops reading ready once it has seen it true")
        sub readsReadyUntilTrue()
            logger = RemoteLogger("Test")
            m.sink.ready = true
            logger.info("one")
            m.sink.ready = false
            logger.info("two")
            m.assertEqual(m.sink.entry.msg, "two")
        end sub

        @it("keeps the last 50 entries and counts the ones it drops")
        sub capsBuffer()
            logger = RemoteLogger("Test")
            for i = 1 to 52
                logger.info(i)
            end for
            m.assertEqual(logger.buffer.count(), 50)
            m.assertEqual(logger.buffer[0].msg, "3")
            m.assertEqual(logger.buffer[49].msg, "52")
            m.assertEqual(logger.bufferedDropped, 2)
            m.assertEqual(m.sink.entry.msg, "sentinel")
        end sub

        @it("writes directly when the Task is already ready at construction")
        sub readyAtConstruction()
            m.sink.ready = true
            logger = RemoteLogger("Test")
            m.assertTrue(logger.ready)
            m.assertFalse(logger.doesExist("buffer"))
            m.sink.ready = false ' never read again
            logger.info("one")
            m.assertEqual(m.sink.entry.seq, 1)
            m.assertEqual(m.sink.entry.msg, "one")
            m.assertEqual(logger.bufferedDropped, 0)
        end sub
    end class
end namespace
