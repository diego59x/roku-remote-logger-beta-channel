{
  "rootDir": ".",
  "files": [
    { "src": "sample/manifest", "dest": "" },
    { "src": "src/**/*", "dest": "" },
    { "src": "sample/source/flows/**/*", "dest": "source/flows" },
    { "src": "tests/**/*.bs", "dest": "source/tests" }
  ],
  "createPackage": true,
  "stagingDir": "out/.test-staging",
  "outFile": "out/channel-tests.zip",
  "plugins": ["rooibos-roku"],
  "rooibos": {
    "showOnlyFailures": true
  }
}
